# Copy to .env and edit. Every value here is optional; the defaults suit development.
#
# FOR A REAL DEPLOYMENT (e.g. PythonAnywhere) the four settings below must
# change - see "DEPLOYING" in GUIDE.txt for the full walkthrough:
#
#   DEBUG=False
#   SECRET_KEY=<a fresh random key, see the command below>
#   ALLOWED_HOSTS=yourname.pythonanywhere.com
#   CSRF_TRUSTED_ORIGINS=         (leave blank - it is derived from the host)
#
# Generate a SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
#
# With DEBUG=False the server refuses to start until SECRET_KEY and
# ALLOWED_HOSTS are set, on purpose - it will not run wide open or with the
# development key.

DEBUG=True
SECRET_KEY=dev-only-key-change-before-deployment
ALLOWED_HOSTS=*
# Leave blank in production too: it is derived from ALLOWED_HOSTS as
# https://<host>. Set it only to trust extra origins.
CSRF_TRUSTED_ORIGINS=

# Production-only HTTPS hardening. All are ignored while DEBUG=True. Turn the
# first two on once HTTPS is proven; the host usually handles the redirect.
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0            # 2592000 = 30 days, once you are sure
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# Database: leave as sqlite, or set to postgres and fill in the rest.
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=smarthoseleak
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# A line with no reading for this long is shown as offline. These two were
# left behind at their old values here while the defaults in settings.py
# moved on, so copying this file wholesale used to make the dashboard slower
# than it is out of the box.
DEVICE_OFFLINE_AFTER_SECONDS=10

# How long per-minute history is kept, in days.
ROLLUP_RETENTION_DAYS=90

# How often the dashboards refresh, in milliseconds.
LIVE_POLL_INTERVAL_MS=2000

# ---------------------------------------------------------------------- SMS
# Sent through iprogSMS (iprogsms.com), a Philippine SMS gateway.
#
# Without a token, messages are queued and wait - nothing is lost, and the
# Notices & SMS page says plainly that no token is set.
IPROGSMS_API_TOKEN=

# Text the household automatically when their line is flagged.
SMS_AUTO_ON_LEAK=True

# Copy the facilitator on every leak alert, at the contact number on their
# account. Set that number in the Django admin under Users.
SMS_FACILITATOR_ON_LEAK=True

# Ask the gateway whether each message actually reached the handset, rather
# than only whether it was accepted.
SMS_TRACK_DELIVERY=True

# ---------------------------------------------------------------------------
# Push notifications for the Owner Portal
#
# Web Push, not Firebase: these keys are a VAPID pair this server makes for
# itself. Nothing is registered with Google or anyone else.
#
#     python manage.py make_push_keys
#
# Run that once and paste the three values it prints below. ONCE: every
# phone's subscription is tied to the public key it saw when the household
# turned alerts on, so generating a new pair silently stops notifications on
# every phone that already has them, with no error anywhere.
#
# Blank is a working state. The portal's Settings page tells the owner that
# notifications are not set up yet and that nothing is wrong with their phone.
#
# Note both installing the portal and receiving notifications need an https://
# address - browsers allow neither over plain http, except on localhost.
# ---------------------------------------------------------------------------
PUSH_ENABLED=True
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Push the household when their line is flagged, alongside the SMS.
PUSH_AUTO_ON_LEAK=True

# ---------------------------------------------------------------------------
# Visit routes on the leak map
#
# Road-following routes from the barangay's water source to each household,
# fetched ONCE from OpenRouteService when a household's coordinates are saved
# and stored on the record - so the map draws them with no internet after
# that. Free key from openrouteservice.org. Blank is a working state: no
# routes are fetched and the map simply shows none; the hoses are unaffected.
#
# For households surveyed before the key existed:
#     python manage.py fetch_routes
# ---------------------------------------------------------------------------
ORS_API_KEY=
# driving-car follows roads (a motorcycle uses the same ones); foot-walking
# also allows footpaths where the map data has them.
ROUTING_PROFILE=driving-car

# ---------------------------------------------------------------------------
# Sign-in codes (OTP) and email
#
# After the password, every role gets a 6-digit code by text or by email,
# valid for 10 minutes. "Remember this device" skips it for 30 days on that
# phone. Texts go through Semaphore (above). Email needs a mailbox to send
# from: a Gmail account with an APP PASSWORD (Google Account -> Security ->
# 2-Step Verification -> App passwords), not the normal password.
#
# Until BOTH are filled in, emails are printed to the server terminal
# instead of sent, and the pages say email is not set up - so an address
# with no app password yet does not break anything.
# With DEBUG=True the code is also shown on the sign-in page, so a demo can
# proceed with no SMS credit and no mailbox.
# ---------------------------------------------------------------------------
OTP_ENABLED=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# ---------------------------------------------------------------------------
# Owner board setup. The hotspot the board raises in setup mode - must match
# the firmware. The grace periods decide when the owner's Settings page says
# "Problem" (seconds of silence) rather than the dashboard's quick 10 s.
# ---------------------------------------------------------------------------
BOARD_SETUP_SSID=LeakDetect-Setup
BOARD_SETUP_PASSWORD=leakdetect123
OWNER_DEVICE_GRACE_SECONDS=180
OWNER_DEVICE_CONNECTING_SECONDS=180
