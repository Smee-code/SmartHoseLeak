__pycache__/
*.py[cod]
.venv/
db.sqlite3
.env
staticfiles/
*.log
.DS_Store

# SQLite WAL sidecar files
db.sqlite3-wal
db.sqlite3-shm
db.sqlite3-journal

# Logins, in plain text. Never in git - the repo is private, but a password
# in version control stays in the history even after the file is deleted.
CREDENTIALS.txt

# Deployment notes with host and account details. Kept out of the public repo
# for the same reason as the credentials above.
PythonAnywhere.txt

# Per-machine editor settings; not project configuration.
.vscode/

# A second copy of the installed skills, for Cursor / Copilot / Codex and
# similar. This project is worked on through Claude Code, which reads
# .claude/skills/ - and two copies in git would drift apart, because the
# installer could not symlink them on Windows.
.agents/

# Per-machine permission allowlists. These accumulate one entry per command
# approved while working, so they are session churn rather than project
# configuration - committing them would put a diff in every commit and tell
# the next person nothing. Installed skills under .claude/skills/ ARE kept.
.claude/settings.json
.claude/settings.local.json
