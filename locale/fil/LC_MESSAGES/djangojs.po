msgstr " - isang text message"

#: .\static\js\app.js:1189
msgid "Sending to every active household."
msgstr "Ipapadala sa lahat ng aktibong sambahayan."

#: .\static\js\app.js:1191
msgid "%(n)s household selected."
msgid_plural "%(n)s households selected."
msgstr[0] "%(n)s sambahayan ang napili."
msgstr[1] "%(n)s sambahayan ang napili."

#: .\static\js\app.js:1192
msgid "Nobody selected yet."
msgstr "Wala pang napili."

#: .\static\js\app.js:1217
msgid "No household matches that."
msgstr "Walang sambahayan na tumutugma diyan."

#: .\static\js\app.js:1218
msgid "Everyone is already selected."
msgstr "Napili na ang lahat."

#: .\static\js\app.js:1325
msgid "Your water is normal"
msgstr "Normal ang tubig mo"

#: .\static\js\app.js:1326
msgid "Nothing wrong with your line right now."
msgstr "Walang problema sa linya mo ngayon."

#: .\static\js\app.js:1329
msgid "Your water is weak"
msgstr "Mahina ang tubig mo"

#: .\static\js\app.js:1330
msgid "Pressure is lower than usual on your line. It may be slow at the tap."
msgstr "Mas mababa sa karaniwan ang pressure sa linya mo. Baka mahina ang tubig sa gripo."

#: .\static\js\app.js:1333
msgid "Possible leak on your line"
msgstr "Posibleng tagas sa linya mo"

#: .\static\js\app.js:1334
msgid "Please check that all your faucets are fully closed. If they are and water is still running, tell the water system facilitator."
msgstr "Pakitingnan kung sarado nang lahat ang mga gripo mo. Kung sarado na pero tuloy-tuloy pa ring umaagos ang tubig, sabihan ang facilitator ng water system."

#: .\static\js\app.js:1337
msgid "Under repair"
msgstr "Inaayos pa"

#: .\static\js\app.js:1338
msgid "The facilitator is working on your line. Supply may stop for a while."
msgstr "Inaayos ng facilitator ang linya mo. Baka mawalan muna ng tubig saglit."

#: .\static\js\app.js:1341
msgid "Not being checked"
msgstr "Hindi nababantayan"

#: .\static\js\app.js:1342
msgid "No readings are coming from your line. Your water may still be fine - the device has stopped reporting."
msgstr "Walang readings na dumarating mula sa linya mo. Baka okay pa rin ang tubig mo - tumigil lang sa pagre-report ang device."

#: .\static\js\app.js:1386
msgid "live"
msgstr "live"

#: .\static\js\app.js:1386
msgid "not reporting"
msgstr "hindi nagre-report"

#: .\static\js\app.js:1431
