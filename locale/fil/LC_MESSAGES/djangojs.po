msgid "%(line)s will stop reporting until you enter the new key on the board."
msgstr "Hihinto sa pagre-report ang %(line)s hangga't hindi mo nailalagay ang bagong key sa board."

#: .\static\js\app.js:698
msgid "This board is not fitted to a line yet, so nothing stops reporting."
msgstr "Hindi pa nakakabit sa linya ang board na ito, kaya walang hihinto sa pagre-report."

#: .\static\js\app.js:723
msgid "%(n)s minute of pressure history"
msgid_plural "%(n)s minutes of pressure history"
msgstr[0] "%(n)s minuto ng pressure history"
msgstr[1] "%(n)s minuto ng pressure history"

#: .\static\js\app.js:724
msgid "%(n)s leak event"
msgid_plural "%(n)s leak events"
msgstr[0] "%(n)s tagas na naitala"
msgstr[1] "%(n)s tagas na naitala"

#: .\static\js\app.js:739
msgid "%(n)s household is served by this line. It is kept, but becomes Unassigned and stops receiving alerts until you move it to another line."
msgid_plural "%(n)s households are served by this line. They are kept, but become Unassigned and stop receiving alerts until you move them to another line."
msgstr[0] "%(n)s sambahayan ang nakakabit sa linyang ito. Mananatili ito, pero magiging Unassigned at hindi na makakatanggap ng alerto hangga't hindi mo inililipat sa ibang linya."
msgstr[1] "%(n)s sambahayan ang nakakabit sa linyang ito. Mananatili ang mga ito, pero magiging Unassigned at hindi na makakatanggap ng alerto hangga't hindi mo inililipat sa ibang linya."

