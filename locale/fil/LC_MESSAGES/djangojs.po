msgid "No households are assigned to this line."
msgstr "Walang sambahayan na nakakabit sa linyang ito."

#: .\static\js\app.js:823
msgid "Showing %(shown)s of %(total)s"
msgstr "Ipinapakita ang %(shown)s sa %(total)s"

