msgstr "Ginagamit para sa linyang ito at sa mga sambahayan nito sa leak map."

#: .\templates\facilitator\segments.html:375
msgid "Add line"
msgstr "Magdagdag ng linya"

#: .\templates\facilitator\segments.html:391
msgid "Edit hose line"
msgstr "I-edit ang linya"

#: .\templates\facilitator\segments.html:457
msgid "Delete hose line?"
msgstr "Tanggalin ang linya?"

#: .\templates\facilitator\segments.html:466
