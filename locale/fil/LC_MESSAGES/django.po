#: .\core\models.py:580
#, python-brace-format
msgid "on {name}"
msgstr "sa {name}"

#: .\core\models.py:581
#, python-brace-format
msgid "on {household_id}'s line ({owner_name})"
msgstr "sa linya ng {household_id} ({owner_name})"

