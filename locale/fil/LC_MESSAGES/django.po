msgid "..."
msgstr "..."

#: .\core\api.py:112
msgid "Check that your faucets are fully closed. If they are and water is still running, tell the facilitator."
msgstr "Tingnan kung sarado nang husto ang mga gripo mo. Kung sarado na pero tuloy-tuloy pa ring umaagos ang tubig, sabihin sa facilitator."

#: .\core\api.py:117
msgid "Water has been running non-stop on your line. Turn off any tap or hose; if all are closed, tell the facilitator."
msgstr "Tuloy-tuloy na umaagos ang tubig sa linya mo. Isara ang anumang gripo o hose; kung sarado na lahat, sabihin sa facilitator."

#: .\core\api.py:121
msgid "Water may be slow at your tap. The source is probably low."
msgstr "Baka mahina ang tubig sa gripo mo. Malamang mababa ang supply sa source."

#: .\core\api.py:123
msgid "The alert on your line has been cleared."
msgstr "Na-clear na ang alerto sa linya mo."

#: .\core\api.py:141
msgid "Possible leak on your water line"
msgstr "Posibleng tagas sa linya ng tubig mo"

#: .\core\api.py:142
#, python-brace-format
msgid "A possible leak was detected on your line on {when}. Please check that all your faucets are fully closed. If they are and water is still running, tell the water system facilitator.\n\nReading at the time: {pressure_bar:.2f} bar, {flow_lpm:.2f} L/min."
msgstr "May na-detect na posibleng tagas sa linya mo noong {when}. Pakitingnan kung sarado nang husto ang lahat ng gripo mo. Kung sarado na pero tuloy-tuloy pa ring umaagos ang tubig, sabihin sa facilitator ng water system.\n\nReading noong oras na iyon: {pressure_bar:.2f} bar, {flow_lpm:.2f} L/min."

#: .\core\api.py:150
msgid "Water has been running on your line"
msgstr "Tuloy-tuloy na umaagos ang tubig sa linya mo"

#: .\core\api.py:151
#, python-brace-format
msgid "Water has been flowing without stopping on your line since before {when}. If you left a tap or hose on, please turn it off. If everything is closed and water is still running, you may have a leak - tell the water system facilitator.\n\nReading at the time: {pressure_bar:.2f} bar, {flow_lpm:.2f} L/min."
msgstr "Tuloy-tuloy na umaagos ang tubig sa linya mo mula pa bago mag-{when}. Kung may naiwan kang bukas na gripo o hose, pakisara ito. Kung sarado na lahat pero umaagos pa rin ang tubig, baka may tagas - sabihin sa facilitator ng water system.\n\nReading noong oras na iyon: {pressure_bar:.2f} bar, {flow_lpm:.2f} L/min."

#: .\core\api.py:160
msgid "Your water is weaker than usual"
msgstr "Mas mahina kaysa dati ang tubig mo"

#: .\core\api.py:161
#, python-brace-format
msgid "Low pressure was detected on your line on {when}. Water may be slow at your tap. This usually means the source is low rather than anything wrong at your house.\n\nReading at the time: {pressure_bar:.2f} bar."
msgstr "May na-detect na mahinang pressure sa linya mo noong {when}. Baka mahina ang tubig sa gripo mo. Kadalasan, ibig sabihin nito ay mababa ang supply sa source, hindi may problema sa bahay mo.\n\nReading noong oras na iyon: {pressure_bar:.2f} bar."

#: .\core\api.py:177
msgid "Your water is back to normal"
msgstr "Normal na ulit ang tubig mo"

#: .\core\api.py:178
#, python-brace-format
msgid "The alert on your line was cleared on {when}. Readings are normal again."
msgstr "Na-clear na ang alerto sa linya mo noong {when}. Normal na ulit ang mga reading."

#: .\core\api.py:354
#, python-brace-format
msgid "LEAK: {who}{owner}{severity}. {pressure_bar:.2f} bar, {flow_lpm:.2f} L/min. Detected by {get_trigger_display}. The owner has been asked to check their faucets."
msgstr "TAGAS: {who}{owner}{severity}. {pressure_bar:.2f} bar, {flow_lpm:.2f} L/min. Na-detect ng {get_trigger_display}. Pinasabihan na ang may-ari na tingnan ang mga gripo niya."

#: .\core\api.py:374
#, python-brace-format
msgid "WATER RUNNING {household_id}: water has run non-stop since {when}. Turn off any tap or hose. If all are closed and it still runs, tell the facilitator."
msgstr "TULOY-TULOY ANG TUBIG {household_id}: tuloy-tuloy na umaagos ang tubig mula {when}. Isara ang anumang gripo o hose. Kung sarado na lahat pero umaagos pa rin, sabihin sa facilitator."

#: .\core\api.py:400
#, python-brace-format
msgid "LEAK ALERT {household_id}: possible leak {when}{severity}. Please check all your faucets are closed. If they are and water still runs, tell the facilitator."
msgstr "ALERTO SA TAGAS {household_id}: posibleng tagas {when}{severity}. Pakitingnan kung sarado ang lahat ng gripo mo. Kung sarado na pero umaagos pa rin ang tubig, sabihin sa facilitator."

#: .\core\api.py:681
#| msgid "Connected"
msgid "Connected to {ssid}."
msgstr "Nakakonekta sa {ssid}."

#: .\core\api.py:683
#, python-brace-format
msgid "Could not join {ssid}; still on {old}."
msgstr "Hindi makasali sa {ssid}; nasa {old} pa rin."

#: .\core\api.py:694
msgid "Your board is on the new WiFi"
msgstr "Nasa bagong WiFi na ang board mo"

#: .\core\api.py:695
#, python-brace-format
msgid "The monitoring board joined {ssid} and is sending readings again."
msgstr "Sumali na ang monitoring board sa {ssid} at nagpapadala na ulit ng reading."

#: .\core\api.py:697
msgid "Your board could not join the new WiFi"
msgstr "Hindi makasali ang board mo sa bagong WiFi"

#: .\core\api.py:698
#, python-brace-format
msgid "The board tried {ssid} and could not connect, so it went back to {old}. Check the network name and password and try again from Settings."
msgstr "Sinubukan ng board ang {ssid} pero hindi makakonekta, kaya bumalik ito sa {old}. Suriin ang pangalan ng network at password at subukan ulit sa Settings."

#: .\core\api.py:700
#| msgid "Sent to network"
msgid "its previous network"
msgstr "ang dati nitong network"

#: .\core\api.py:1134
msgid "Notifications are working"
msgstr "Gumagana ang mga notification"

#: .\core\api.py:1135
msgid "This is a test. Alerts about your water will look like this."
msgstr "Test lang ito. Ganito ang itsura ng mga alerto tungkol sa tubig mo."

#: .\core\api.py:1142
msgid "This phone is not registered for notifications. Turn them off and on again."
msgstr "Hindi naka-register ang phone na ito para sa mga notification. I-off at i-on ulit ang mga ito."

#: .\core\api.py:1144
msgid "No phone is registered for notifications yet."
msgstr "Wala pang phone na naka-register para sa mga notification."

#: .\core\forms.py:41
#, python-brace-format
msgid "That is outside {municipality_name}. Expected roughly {south:.2f} to {north:.2f}."
msgstr "Nasa labas iyan ng {municipality_name}. Dapat nasa humigit-kumulang {south:.2f} hanggang {north:.2f}."

#: .\core\forms.py:47
#, python-brace-format
msgid "That is outside {municipality_name}. Expected roughly {west:.2f} to {east:.2f}."
msgstr "Nasa labas iyan ng {municipality_name}. Dapat nasa humigit-kumulang {west:.2f} hanggang {east:.2f}."

#: .\core\forms.py:69
msgid "Enter a Philippine mobile number, like 09171234567 or +639171234567."
msgstr "Maglagay ng Philippine mobile number, tulad ng 09171234567 o +639171234567."

#: .\core\forms.py:83
msgid "e.g. beside the barangay hall"
msgstr "hal. sa tabi ng barangay hall"

#: .\core\forms.py:91 .\core\forms.py:271
msgid "Enter both latitude and longitude, or leave both blank."
msgstr "Ilagay pareho ang latitude at longitude, o iwanang blangko pareho."

#: .\core\forms.py:120
msgid "Latitude"
msgstr "Latitude"

#: .\core\forms.py:124
msgid "Longitude"
msgstr "Longitude"

#: .\core\forms.py:166
msgid "Register anyway - this is a different household"
msgstr "Irehistro pa rin - ibang sambahayan ito"

#: .\core\forms.py:188
msgid "Create an Owner Portal login for this household"
msgstr "Gumawa ng Owner Portal login para sa sambahayang ito"

#: .\core\forms.py:189
msgid "A username and temporary password are generated and shown once after saving."
msgstr "Gagawa ng username at pansamantalang password na ipapakita isang beses lang pagkatapos i-save."

#: .\core\forms.py:195 .\templates\facilitator\dashboard.html:267
#: .\templates\facilitator\segments.html:82
msgid "Device"
msgstr "Device"

#: .\core\forms.py:198
msgid "No device yet"
msgstr "Wala pang device"

#: .\core\forms.py:199
msgid "Register a new board"
msgstr "Mag-register ng bagong board"

#: .\core\forms.py:200
msgid "Use a board already registered"
msgstr "Gumamit ng board na naka-register na"

#: .\core\forms.py:204
msgid "Board label"
msgstr "Label ng board"

#: .\core\forms.py:205
msgid "Optional. Something you can recognise it by."
msgstr "Optional. Kahit ano na makakatulong para makilala mo ito."

#: .\core\forms.py:208
msgid "Which board"
msgstr "Aling board"

#: .\core\forms.py:209
msgid "Choose a board"
msgstr "Pumili ng board"

#: .\core\forms.py:276
msgid "Choose the board, or pick a different option."
msgstr "Piliin ang board, o pumili ng ibang option."

#: .\core\forms.py:283
msgid "A household with this contact number or email is already registered (listed below). Tick \"Register anyway\" if this really is a different household."
msgstr "May nakarehistro nang sambahayan sa contact number o email na ito (nakalista sa ibaba). I-tick ang \"Irehistro pa rin\" kung talagang ibang sambahayan ito."

#: .\core\forms.py:331
msgid "e.g. Lower Dakong Patag"
msgstr "hal. Lower Dakong Patag"

#: .\core\forms.py:337
msgid "Inactive barangays keep their households and history but stop appearing when registering new ones or assigning facilitators."
msgstr "Nananatili ang mga sambahayan at history ng inactive na barangay, pero hindi na ito lalabas sa pagrerehistro ng bago o sa pag-assign ng facilitator."

#: .\core\forms.py:359 .\core\forms.py:425
msgid "First name"
msgstr "Pangalan"

#: .\core\forms.py:359 .\core\forms.py:425
msgid "Last name"
msgstr "Apelyido"

#: .\core\forms.py:361
msgid "Where leak alerts and sign-in codes are texted."
msgstr "Dito ite-text ang mga alerto sa tagas at mga sign-in code."

#: .\core\forms.py:362
msgid "Optional. Sign-in codes and notices by email instead of text."
msgstr "Optional. Mga sign-in code at abiso sa email imbes na text."

#: .\core\forms.py:427
msgid "Sign-in codes and alerts are texted here."
msgstr "Dito ite-text ang mga sign-in code at alerto."

#: .\core\forms.py:428
msgid "Sign-in codes and notices can be emailed here instead."
msgstr "Puwede ring i-email dito ang mga sign-in code at abiso."

#: .\core\forms.py:455
msgid "Purok or street"
msgstr "Purok o kalye"

#: .\core\forms.py:456
msgid "e.g. Purok 2, or the street and house no."
msgstr "hal. Purok 2, o ang kalye at house no."

#: .\core\forms.py:457
msgid "The barangay, municipality and province are added automatically."
msgstr "Awtomatikong idadagdag ang barangay, munisipyo at probinsya."

#: .\core\forms.py:481 .\templates\404.html:48
#: .\templates\admin\analytics.html:15 .\templates\admin\archive.html:15
#: .\templates\admin\barangays.html:21 .\templates\admin\dashboard.html:44
#: .\templates\admin\data.html:19 .\templates\admin\households.html:3
#: .\templates\admin\households.html:15 .\templates\base.html:117
#: .\templates\base.html:164 .\templates\facilitator\dashboard.html:220
#: .\templates\facilitator\households.html:3
#: .\templates\facilitator\households.html:15 .\templates\home.html:151
msgid "Households"
msgstr "Mga sambahayan"

#: .\core\forms.py:489
msgid "e.g. Scheduled maintenance this weekend"
msgstr "hal. Nakaiskedyul na maintenance ngayong weekend"

#: .\core\forms.py:492 .\core\forms.py:725
msgid "Also send by email"
msgstr "Ipadala rin sa email"

#: .\core\forms.py:512 .\core\forms.py:746
msgid "Choose at least one way to send this - in the app, by SMS, by email, or any mix."
msgstr "Pumili ng kahit isang paraan ng pagpapadala - sa app, sa SMS, sa email, o kahit anong kombinasyon."

#: .\core\forms.py:515
msgid "Pick at least one household, or choose a wider audience."
msgstr "Pumili ng kahit isang sambahayan, o pumili ng mas malawak na audience."

#: .\core\forms.py:531
msgid "CSV file"
msgstr "CSV file"

#: .\core\forms.py:532
msgid "Columns: owner_name, address, contact_number, and optionally barangay."
msgstr "Mga column: owner_name, address, contact_number, at optional na barangay."

#: .\core\forms.py:536
msgid "Barangay for rows that do not name one"
msgstr "Barangay para sa mga row na walang nakalagay"

#: .\core\forms.py:537
msgid "Choose a barangay"
msgstr "Pumili ng barangay"

#: .\core\forms.py:548
msgid "Backup file (.json)"
msgstr "Backup file (.json)"

#: .\core\forms.py:550
msgid "Type RESTORE to confirm"
msgstr "I-type ang RESTORE para kumpirmahin"

#: .\core\forms.py:551
msgid "Restoring overwrites current records that share an id with the backup."
msgstr "Kapag nag-restore, mapapalitan ang mga kasalukuyang record na pareho ang id sa backup."

#: .\core\forms.py:557
msgid "Type RESTORE exactly to confirm."
msgstr "I-type nang eksakto ang RESTORE para kumpirmahin."

#: .\core\forms.py:576
msgid "e.g. Application visit - check the tap and the hose run"
msgstr "hal. Pagbisita para sa application - tingnan ang gripo at ang hose"

#: .\core\forms.py:578
msgid "Visit date"
msgstr "Petsa ng pagbisita"

#: .\core\forms.py:578 .\templates\admin\dashboard.html:95
#: .\templates\admin\workorders.html:36 .\templates\owner\complaints.html:92
msgid "Facilitator"
msgstr "Facilitator"

#: .\core\forms.py:580
msgid "Who will make the visit. Choosing one schedules it and texts them and the household."
msgstr "Sino ang bibisita. Kapag pumili ka, maiiskedyul ito at mate-text siya at ang sambahayan."

#: .\core\forms.py:581
msgid "The household to visit. It need not have a portal account yet - the text goes to the number on its record."
msgstr "Ang sambahayang bibisitahin. Hindi kailangang may portal account na ito - ipapadala ang text sa numerong nasa record nito."

#: .\core\forms.py:604
msgid "Describe the problem"
msgstr "Ilarawan ang problema"

#: .\core\forms.py:606
msgid "Short summary of the problem"
msgstr "Maikling buod ng problema"

#: .\core\forms.py:608
msgid "When did it start? What exactly are you seeing?"
msgstr "Kailan ito nagsimula? Ano ba talaga ang nakikita mo?"

#: .\core\forms.py:622
msgid "Write a message..."
msgstr "Sumulat ng mensahe..."

#: .\core\forms.py:629 .\core\views.py:1453
msgid "Write something before sending."
msgstr "Sumulat muna bago ipadala."

#: .\core\forms.py:654
msgid "Write your reply to the household owner..."
msgstr "Isulat ang sagot mo sa may-ari ng sambahayan..."

#: .\core\forms.py:700
msgid "Send to"
msgstr "Ipadala sa"

#: .\core\forms.py:703 .\core\models.py:1649
msgid "All active households"
msgstr "Lahat ng aktibong sambahayan"

#: .\core\forms.py:708
msgid "e.g. Scheduled repair this afternoon"
msgstr "hal. Nakaiskedyul na pag-aayos ngayong hapon"

#: .\core\forms.py:713
msgid "Include the expected restoration time if you know it."
msgstr "Isama ang inaasahang oras ng pagbabalik ng tubig kung alam mo."

#: .\core\forms.py:719
msgid "Show in the app"
msgstr "Ipakita sa app"

#: .\core\forms.py:722
msgid "Also send as SMS"
msgstr "Ipadala rin bilang SMS"

#: .\core\forms.py:726
msgid "To households with an email on their record or their login."
msgstr "Sa mga sambahayang may email sa record o sa login nila."

#: .\core\forms.py:750
msgid "Pick at least one household, or tick 'All active households'."
msgstr "Pumili ng kahit isang sambahayan, o i-tick ang 'Lahat ng aktibong sambahayan'."

#: .\core\forms.py:789
msgid "The board fitted to this line. Leave blank until one is installed - the dashboard then shows the line as awaiting hardware rather than as a fault."
msgstr "Ang board na nakakabit sa linyang ito. Iwanang blangko hangga't wala pang nakakabit - ipapakita ng dashboard na naghihintay pa ng hardware ang linya, hindi na may sira."

#: .\core\forms.py:794
msgid "Below this, the line reports Low Water Supply. The device picks the new value up within seconds - no re-flashing."
msgstr "Kapag mas mababa dito, mag-uulat ang linya ng Low Water Supply. Makukuha ng device ang bagong halaga sa loob ng ilang segundo - walang re-flashing."

#: .\core\forms.py:797
msgid "Optional. Fill all four coordinates to draw this line on the map view."
msgstr "Optional. Punan ang lahat ng apat na coordinate para maiguhit ang linyang ito sa map view."

#: .\core\forms.py:818
#, python-brace-format
msgid "That board is already fitted to {line}. Take it off that line first, or choose a spare board."
msgstr "Nakakabit na ang board na iyon sa {line}. Tanggalin muna ito sa linyang iyon, o pumili ng spare na board."

#: .\core\forms.py:836
msgid "A threshold of 0 can never be crossed, so this line would never report low supply. Use at least 0.05 bar."
msgstr "Hindi kailanman malalampasan ang threshold na 0, kaya hindi kailanman magre-report ng mahinang supply ang linyang ito. Gumamit ng kahit 0.05 bar."

#: .\core\forms.py:841
msgid "That is higher than a gravity-fed line normally reaches, so it would report low supply permanently. Rural systems usually sit between 0.3 and 2 bar."
msgstr "Mas mataas iyan kaysa karaniwang naaabot ng gravity-fed na linya, kaya palaging magre-report ito na mahina ang supply ng tubig. Karaniwang nasa 0.3 hanggang 2 bar ang mga rural na sistema."

#: .\core\forms.py:887
msgid "e.g. Replacing coupling at the 22 m marker"
msgstr "hal. Pinapalitan ang coupling sa 22 m marker"

#: .\core\forms.py:939
msgid "The leak time must be longer than the water-running warning time."
msgstr "Dapat mas matagal ang oras para sa tagas kaysa sa oras ng babala na tuloy-tuloy ang tubig."

#: .\core\mail.py:28
#, python-brace-format
msgid "Email is not set up yet: {email_host_user} is the sending address, but EMAIL_HOST_PASSWORD (its Gmail app password) is blank in .env. Until then messages are printed to the server terminal instead."
msgstr "Hindi pa naka-set up ang email: {email_host_user} ang sending address, pero blangko ang EMAIL_HOST_PASSWORD (ang Gmail app password nito) sa .env. Hangga't ganoon, ipi-print muna ang mga mensahe sa terminal ng server."

#: .\core\mail.py:33
msgid "Email is not set up: messages are printed to the server terminal instead. Add EMAIL_HOST_USER and EMAIL_HOST_PASSWORD (a Gmail app password) to .env."
msgstr "Hindi naka-set up ang email: ipi-print muna ang mga mensahe sa terminal ng server. Idagdag ang EMAIL_HOST_USER at EMAIL_HOST_PASSWORD (isang Gmail app password) sa .env."

#: .\core\mail.py:36
#, python-brace-format
msgid "Emails are sent from {default_from_email}."
msgstr "Ipinapadala ang mga email mula sa {default_from_email}."

